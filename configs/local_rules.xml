<group name="local,syslog,sshd,web,">
  <!-- Détection critique SQL Injection (MITRE ATT&CK T1190) -->
  <rule id="100002" level="12">
    <if_sid>31100</if_sid>
    <match>UNION%20SELECT|UNION SELECT|SELECT.*FROM</match>
    <description>SOC Alert: SQL Injection (SQLi) attempt detected from $(srcip)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>
</group>
